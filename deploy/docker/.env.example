# Copy this file to ".env" (same folder as the docker-compose file) and fill it in.

# The domain name of this server. Its DNS record must point at this machine.
GORGET_DOMAIN=vpn.example.com

# Optional: Let's Encrypt emails you before a certificate expires.
GORGET_EMAIL=

# Optional: pin a release such as 0.4.0 instead of always taking the newest.
# GORGET_VERSION=latest

# Optional: set to true while testing, to avoid Let's Encrypt rate limits.
# GORGET_TLS_STAGING=false

# Only for docker-compose.postgres.yml: a long random password (openssl rand -hex 24).
# POSTGRES_PASSWORD=
