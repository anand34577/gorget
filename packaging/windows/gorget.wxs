<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v4+ source.  Build with packaging/windows/build-msi.ps1 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Gorget" Manufacturer="Gorget" Version="$(var.Version)" Scope="perMachine"
           UpgradeCode="6C1F4B0E-7D2A-4C55-9A0B-3E5D8F1A2B77" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Gorget is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="app.ico" SourceFile="$(var.Root)\desktop\icons\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/anand34577/gorget" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Gorget" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- The service: runs as LocalSystem because it creates the network adapter and firewall rules. -->
    <Component Id="DaemonComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="GorgetExe" Source="$(var.BinDir)\gorget.exe" KeyPath="yes" />
      <ServiceInstall Id="GorgetService" Name="gorget" DisplayName="Gorget VPN"
                      Description="Gorget mesh VPN client service." Type="ownProcess" Start="auto"
                      ErrorControl="normal" Arguments="daemon" Account="LocalSystem" Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart"
                       SecondFailureActionType="restart" ThirdFailureActionType="restart"
                       RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="GorgetServiceControl" Name="gorget" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
    </Component>

    <Component Id="WintunComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="WintunDll" Source="$(var.BinDir)\wintun.dll" KeyPath="yes" />
    </Component>

    <Component Id="DesktopComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="GorgetDesktopExe" Source="$(var.BinDir)\gorget-desktop.exe" KeyPath="yes">
        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Gorget" Icon="app.ico"
                  WorkingDirectory="INSTALLFOLDER" Advertise="no" />
      </File>
      <!-- Start the tray icon (hidden window) at every sign-in. -->
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="Gorget"
                     Type="string" Value="&quot;[INSTALLFOLDER]gorget-desktop.exe&quot; --hidden" />
    </Component>

    <!-- Make the installing user the "operator": they can use the tray app and CLI without
         elevation. Others can still look at the status. -->
    <CustomAction Id="SetOperator" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]gorget.exe&quot; operator set &quot;[LogonUser]&quot;" />
    <InstallExecuteSequence>
      <Custom Action="SetOperator" After="InstallServices" Condition="NOT Installed AND LogonUser" />
    </InstallExecuteSequence>

    <!-- Put gorget.exe on PATH for the CLI. -->
    <Component Id="PathComponent" Directory="INSTALLFOLDER" Guid="*">
      <Environment Id="GorgetPath" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Gorget" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Gorget" Level="1">
      <ComponentRef Id="DaemonComponent" />
      <ComponentRef Id="WintunComponent" />
      <ComponentRef Id="DesktopComponent" />
      <ComponentRef Id="PathComponent" />
    </Feature>
  </Package>
</Wix>
